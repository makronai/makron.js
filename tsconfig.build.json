{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-package",
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*", "src/types/ambient.d.ts"],
  "exclude": ["node_modules", "dist", "dist-package", "tests", "src/App.tsx", "src/main.tsx"]
}
