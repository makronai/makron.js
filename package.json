{
  "name": "makronjs",
  "version": "0.1.1",
  "description": "Unified JavaScript/TypeScript integration engine for hosted LLMs, local endpoints, browser runtimes, and ecosystem bridges.",
  "license": "MIT",
  "type": "module",
  "main": "./dist-package/index.cjs",
  "module": "./dist-package/index.js",
  "keywords": ["makron","makronjs","nextjs","reactjs","transformersjs","llm","wrapper"],
  "author": "dwmk",
  "types": "./dist-package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-package/index.d.ts",
      "import": "./dist-package/index.js",
      "require": "./dist-package/index.cjs"
    },
    "./providers": {
      "types": "./dist-package/providers/index.d.ts",
      "import": "./dist-package/providers/index.js",
      "require": "./dist-package/providers/index.cjs"
    },
    "./browser": {
      "types": "./dist-package/browser/index.d.ts",
      "import": "./dist-package/browser/index.js"
    },
    "./models": {
      "types": "./dist-package/models/index.d.ts",
      "import": "./dist-package/models/index.js",
      "require": "./dist-package/models/index.cjs"
    },
    "./integrations": {
      "types": "./dist-package/integrations/index.d.ts",
      "import": "./dist-package/integrations/index.js",
      "require": "./dist-package/integrations/index.cjs"
    },
    "./components": {
      "types": "./dist-package/components/index.d.ts",
      "import": "./dist-package/components/index.js",
      "require": "./dist-package/components/index.cjs"
    }
  },
  "files": [
    "dist-package",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "build": "tsup",
    "build:package": "tsup",
    "test": "tsx --test tests/**/*.test.ts",
    "clean": "rm -rf dist dist-package",
    "lint": "tsc --noEmit",
    "models:validate": "tsx scripts/validate-model-catalog.ts",
    "models:sync": "tsx scripts/sync-model-catalog.ts",
    "check:exports": "tsx scripts/check-exports.ts",
    "release:check": "tsx scripts/release-check.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
